# Copy this file to .env.local (and set DATABASE_URL in .env for the Prisma CLI)
# and fill in real values. Never commit real secrets.

# Prisma Postgres connection string (see console.prisma.io).
DATABASE_URL=

# Random 32+ byte secret used to sign session cookies. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Admin login is not stored in the database — only these two env vars grant admin access.
# Generate ADMIN_PASSWORD_HASH with:
# node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
# In .env/.env.local, escape each $ in the bcrypt hash as \$ for Next's env loader.
# In Vercel's environment settings, enter the unescaped hash.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Real Ozow merchant credentials (see your Ozow merchant portal).
OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
OZOW_API_KEY=
OZOW_IS_TEST=true

# Overrides the auto-detected origin used to build Ozow redirect/notify URLs.
# Required in production so Ozow's server-to-server notify webhook can reach this app.
NEXT_PUBLIC_APP_URL=

# Required for certificate uploads. Create a Vercel Blob store and connect it to this
# project — Vercel injects this automatically in deployed environments.
BLOB_READ_WRITE_TOKEN=

# Optional: enables invoice emails via Resend (https://resend.com). Without this,
# invoices are still generated and viewable, but no email is sent.
RESEND_API_KEY=
INVOICE_FROM_EMAIL=HERC <info@herc.org.za>
